# Copy to .env and fill in. Never commit real values.

# --- Auth (Auth.js v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails allowed to sign in as owners
OWNER_EMAILS=
# Only needed outside Vercel (e.g. `npm start` or self-hosting behind a trusted proxy).
# Vercel and `npm run dev` trust the host automatically.
# AUTH_TRUST_HOST=true
# AUTH_URL=http://localhost:3000

# --- Firebase Admin (service account) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional named Firestore database (default database when unset)
# FIRESTORE_DATABASE_ID=
# Set to use the local emulator instead of credentials, e.g. 127.0.0.1:8080
# FIRESTORE_EMULATOR_HOST=

# --- Google Maps ---
# Browser key: restrict by HTTP referrer (Maps JavaScript API, Places API (New))
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Cloud map style id (Advanced Markers + dark mode). DEMO_MAP_ID works for development.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Server key: Routes API + Places API (New), restricted by API, no app restriction (never exposed to the browser). See SETUP.md
GOOGLE_MAPS_SERVER_KEY=
# Tests/local dev without a server key: straight-line routes and fake places
# MAPS_FAKE=1

# --- Gemini ---
GEMINI_API_KEY=
# Optional per-task overrides (defaults: gemini-4-argon, fallback gemini-4-hydrogen).
# Tasks: CHAT, IMPORT, AGENT. Thinking: MINIMAL | LOW | MEDIUM | HIGH.
# GEMINI_MODEL_CHAT=gemini-4-argon
# GEMINI_MODEL_FALLBACK=gemini-4-hydrogen
# GEMINI_THINKING_CHAT=LOW
# Assistant with tools: Argon took ~20-42 s per turn at LOW; Hydrogen ~4-7 s (same proposals).
# GEMINI_MODEL_AGENT=gemini-4-hydrogen
# GEMINI_TIMEOUT_CHAT_MS=45000
# Tests/e2e only: deterministic fake responses, no API calls.
# AI_FAKE=1
